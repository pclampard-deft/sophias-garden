---
pagination:
  data: routes
  size: 1
  alias: route
permalink: "{{ route.url }}"
layout: base.njk
---

{% set c = resort %}
{% set p = route.data %}

{% macro gallery(items, heading) %}
  {% if items.length %}
    <section class="section gallery-section">
      <h2>{{ heading }}</h2>
      <div class="gallery">
        {% for item in items %}
          <figure>
            <img src="{{ item.image | asset }}"
                 alt="{{ item.alt }}"
                 width="1000"
                 height="750"
                 loading="lazy"
                 decoding="async">
            {% if item.caption %}
              <figcaption>{{ item.caption }}</figcaption>
            {% endif %}
          </figure>
        {% endfor %}
      </div>
    </section>
  {% endif %}
{% endmacro %}

{% macro roomCards(rooms, label) %}
  <div class="room-grid">
    {% for room in rooms %}
      <article class="room-card">
        <a href="/rooms/{{ room.slug }}/" class="image-link"
           aria-label="{{ room.title }}">
          <img src="{{ room.image | asset }}"
               alt="{{ room.imageAlt }}"
               width="1000"
               height="750"
               loading="lazy"
               decoding="async">
        </a>
        <div class="room-heading">
          <h3><a href="/rooms/{{ room.slug }}/">{{ room.title }}</a></h3>
          <span>{{ room.size }}</span>
        </div>
        <p>{{ room.summary }}</p>
        <a class="text-link" href="/rooms/{{ room.slug }}/">{{ label }}</a>
      </article>
    {% endfor %}
  </div>
{% endmacro %}

{% if route.type == "home" %}

  <section class="opening">
    <div class="garden-art">
      <img class="hero-photo"
           src="{{ p.heroImage | asset }}"
           alt="{{ p.heroAlt }}"
           width="1000"
           height="1250"
           fetchpriority="high">

      <h1 class="hero-wordmark">
        <span>{{ c.site.wordmarkFirst }}</span>
        <span>{{ c.site.wordmarkSecond }}</span>
      </h1>

      <p class="art-caption">{{ p.artCaption }}</p>
    </div>

    <div class="opening-copy">
      <p class="location">{{ c.site.location }}</p>

      <figure class="memory">
        {% if p.memoryImage %}
          <img src="{{ p.memoryImage | asset }}"
               alt="{{ p.memoryAlt }}"
               width="650"
               height="450"
               decoding="async">
        {% else %}
          <div class="memory-image" aria-hidden="true"></div>
        {% endif %}
        <figcaption>{{ p.memoryCaption }}</figcaption>
      </figure>

      <div class="intro">
        <h2>{{ p.title }}</h2>
        <div class="prose">{{ p.body | markdown | safe }}</div>
        <a class="text-link" href="{{ p.ctaUrl | safeHref }}">{{ p.ctaLabel }}</a>
      </div>

      <p class="opening-note preserve-lines">{{ p.openingNote }}</p>
    </div>
  </section>

  <section class="section">
    <div class="section-heading">
      <h2>{{ p.stayHeading }}</h2>
      <div class="prose">{{ p.stayBody | markdown | safe }}</div>
    </div>

    {{ roomCards(c.rooms, c.ui.roomLink) }}
  </section>

  <section class="interlude">
    {% for item in p.highlights %}
      <article>
        <h2>{{ item.title }}</h2>
        <div class="prose">{{ item.body | markdown | safe }}</div>
        <a class="text-link" href="{{ item.url | safeHref }}">{{ item.linkLabel }}</a>
      </article>
    {% endfor %}
  </section>

  <section class="invitation" id="opening-updates">
    <div class="sunset">
      {% if p.invitationImage %}
        <img src="{{ p.invitationImage | asset }}"
             alt="{{ p.invitationAlt }}"
             width="1000"
             height="1000"
             loading="lazy">
      {% else %}
        <span class="monogram" aria-hidden="true">{{ p.monogram }}</span>
      {% endif %}
      <p class="sunset-caption">{{ p.invitationCaption }}</p>
    </div>

    <div class="invite-copy">
      <h2>{{ p.invitationTitle }}</h2>
      <div class="prose">{{ p.invitationBody | markdown | safe }}</div>

      <form name="opening-updates"
            method="POST"
            action="/thanks/"
            data-netlify="true"
            netlify-honeypot="bot-field">

        <input type="hidden" name="form-name" value="opening-updates">

        <p class="honeypot" aria-hidden="true">
          <label>{{ c.ui.honeypotLabel }}
            <input name="bot-field" tabindex="-1" autocomplete="off">
          </label>
        </p>

        <label for="updates-name">{{ c.ui.nameLabel }}</label>
        <input id="updates-name" name="name" autocomplete="name"
               maxlength="100" required>

        <label for="updates-email">{{ c.ui.emailLabel }}</label>
        <input id="updates-email" name="email" type="email"
               autocomplete="email" maxlength="254" required>

        <label class="checkbox">
          <input name="marketing-consent" type="checkbox"
                 value="yes" required>
          <span>{{ c.ui.waitlistConsent }}</span>
        </label>

        <input type="hidden" name="consent-wording"
               value="{{ c.ui.waitlistConsent }}">

        <p><a href="/privacy/">{{ c.ui.privacyLink }}</a></p>

        <button type="submit">{{ c.ui.joinWaitlist }}</button>
      </form>
    </div>
  </section>

{% else %}

  <section class="page-heading section">
    <p class="eyebrow">{{ c.site.location }}</p>
    <h1>{{ p.title }}</h1>
    <div class="prose intro-prose">{{ p.body | markdown | safe }}</div>
  </section>

  {% if route.type == "rooms" %}

    <section class="section section-tight">
      {{ roomCards(c.rooms, c.ui.roomLink) }}
      <p class="room-note">{{ p.note }}</p>
    </section>

  {% elif route.type == "room" %}

    <section class="section section-tight room-detail">
      <img class="wide-image"
           src="{{ p.image | asset }}"
           alt="{{ p.imageAlt }}"
           width="1400"
           height="1000"
           fetchpriority="high">

      <div class="room-facts">
        <p>{{ p.size }}</p>
        <ul>
          {% for amenity in p.amenities %}
            <li>{{ amenity.text }}</li>
          {% endfor %}
        </ul>

        <a class="text-link" href="/book/">{{ c.ui.bookButton }}</a>
        <a class="text-link" href="/rooms/">{{ c.ui.allRooms }}</a>
      </div>
    </section>

    {{ gallery(p.gallery, c.ui.galleryLabel) }}

  {% elif route.type == "dining" %}

    <section class="section section-tight">
      <img class="wide-image"
           src="{{ p.heroImage | asset }}"
           alt="{{ p.heroAlt }}"
           width="1600"
           height="900"
           fetchpriority="high">

      <div class="two-column dining-intro">
        <div>
          <h2>{{ p.venueName }}</h2>
          <a class="text-link" href="/contact/">{{ c.ui.contactButton }}</a>
        </div>

        <div>
          <h2>{{ p.hoursHeading }}</h2>
          <p class="preserve-lines">{{ p.hours }}</p>
        </div>
      </div>

      <div class="section-heading">
        <h2>{{ p.menuHeading }}</h2>
        <p>{{ p.menuNote }}</p>
      </div>

      {% for category in p.menuSections %}
        <section class="menu-category">
          <h3>{{ category.title }}</h3>

          {% for item in category.items %}
            <div class="menu-item">
              <div>
                <h4>{{ item.name }}</h4>
                <p>{{ item.description }}</p>
              </div>
              <p class="price">{{ item.price }}</p>
            </div>
          {% endfor %}
        </section>
      {% endfor %}

      {% if p.menuPdf %}
        <a class="text-link" href="{{ p.menuPdf | asset }}">
          {{ c.ui.menuDownload }}
        </a>
      {% endif %}
    </section>

    {{ gallery(p.gallery, c.ui.galleryLabel) }}

  {% elif route.type == "booking" %}

    <section class="section section-tight booking-section">
      {% if p.enabled %}

        {% if p.bookingUrl %}
          <p>
            <a class="button" href="{{ p.bookingUrl | safeHref }}">
              {{ p.externalLabel }}
            </a>
          </p>
        {% endif %}

        {% if p.mode == "embed" and p.propertyCode %}
          <div class="booking-notice">
            <p>{{ p.embedNotice }}</p>

            <button type="button"
                    id="load-booking"
                    data-property="{{ p.propertyCode }}">
              {{ p.loadLabel }}
            </button>

            <p id="booking-error" role="status" hidden>{{ p.errorMessage }}</p>
          </div>

          <div id="cloudbeds-container" class="cloudbeds-container"></div>

          <script src="/assets/booking.js" defer></script>
        {% endif %}

        <p class="room-note">{{ p.policyText }}</p>
        <p><a href="/terms/">{{ c.terms.title }}</a></p>

      {% else %}
        <p>{{ p.closedMessage }}</p>
      {% endif %}

      <a class="text-link" href="/contact/">{{ c.ui.contactButton }}</a>
    </section>

  {% elif route.type == "explore" %}

    <section class="section section-tight">
      <img class="wide-image"
           src="{{ p.heroImage | asset }}"
           alt="{{ p.heroAlt }}"
           width="1600"
           height="900"
           fetchpriority="high">

      <div class="faq">
        <h2>{{ p.faqHeading }}</h2>

        {% for faq in p.faqs %}
          <details>
            <summary>{{ faq.question }}</summary>
            <p>{{ faq.answer }}</p>
          </details>
        {% endfor %}
      </div>
    </section>

  {% elif route.type == "contact" %}

    <section class="section section-tight two-column">
      <div class="contact-details">
        <address>
          {{ c.site.streetAddress }}<br>
          {{ c.site.locality }}, {{ c.site.region }}
          {{ c.site.postalCode }}<br>
          {{ c.site.countryName }}
        </address>

        <p><a href="mailto:{{ c.site.email }}">{{ c.site.email }}</a></p>

        {% if c.site.phone %}
          <p><a href="tel:{{ c.site.phone }}">{{ c.site.phone }}</a></p>
        {% endif %}

        {% if c.site.mapUrl %}
          <a class="text-link" href="{{ c.site.mapUrl | safeHref }}">
            {{ c.ui.mapLink }}
          </a>
        {% endif %}
      </div>

      <div>
        <h2>{{ p.formHeading }}</h2>

        <form name="enquiry"
              method="POST"
              action="/thanks/"
              data-netlify="true"
              netlify-honeypot="bot-field">

          <input type="hidden" name="form-name" value="enquiry">

          <p class="honeypot" aria-hidden="true">
            <label>{{ c.ui.honeypotLabel }}
              <input name="bot-field" tabindex="-1" autocomplete="off">
            </label>
          </p>

          <label for="enquiry-name">{{ c.ui.nameLabel }}</label>
          <input id="enquiry-name" name="name" autocomplete="name"
                 maxlength="100" required>

          <label for="enquiry-email">{{ c.ui.emailLabel }}</label>
          <input id="enquiry-email" name="email" type="email"
                 autocomplete="email" maxlength="254" required>

          <label for="enquiry-message">{{ c.ui.messageLabel }}</label>
          <textarea id="enquiry-message" name="message"
                    rows="7" maxlength="5000" required></textarea>

          <label class="checkbox">
            <input name="privacy-acknowledgement" type="checkbox"
                   value="yes" required>
            <span>{{ c.ui.enquiryConsent }}</span>
          </label>

          <p><a href="/privacy/">{{ c.ui.privacyLink }}</a></p>
          <p class="form-note">{{ c.ui.formNote }}</p>

          <button type="submit">{{ c.ui.sendEnquiry }}</button>
        </form>
      </div>
    </section>

  {% elif route.type == "text" %}

    <div class="section section-tight">
      <a class="text-link" href="/">{{ c.ui.homeLabel }}</a>
    </div>

  {% endif %}

{% endif %}